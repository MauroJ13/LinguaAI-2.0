# LinguaAI needs NO configuration. Without this file the tutor runs on free AI
# services that require no account and no key (OVHcloud AI Endpoints, LLM7.io).
#
# Everything below is OPTIONAL and only matters if someone wants to add Google
# Gemini as the first choice. The file is read by the SERVER only (npm run dev,
# npm start, or a host's environment settings); nothing here is ever bundled
# into the browser code – do NOT rename these to VITE_*.

# Optional Gemini key (free tier). Creating one needs a Google account whose
# owner meets Google's age requirement for AI Studio – if that is not you, an
# adult can create it in their own account, or simply leave this empty.
# https://aistudio.google.com/apikey – keep billing switched OFF for the Google
# project behind the key: without billing, Google cannot charge anything.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Only relevant when GEMINI_API_KEY is set.
# ---------------------------------------------------------------------------

# Pin one model ID. Empty = LinguaAI asks Google which free-tier models the key
# can use and picks the newest Flash-Lite, then Flash. Only free-tier families
# (Flash, Flash-Lite, Gemma) are accepted.
GEMINI_MODEL=

# Usage protection (requests to the AI tutor)
VISITOR_PER_MINUTE=
VISITOR_PER_DAY=
SITE_PER_MINUTE=
SITE_PER_DAY=

# Set to true when the server runs behind a hosting proxy (Render, Railway …)
# so each visitor is counted by their own IP address.
TRUST_PROXY=

# Extra origins allowed to call the API (comma separated). Not needed when the
# app and the API are served from the same address, which is the default.
ALLOWED_ORIGINS=

# Port for "npm start" (default 8787).
PORT=
